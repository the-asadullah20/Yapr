# ==============================================================================
# YAPR BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Postgres & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Redis (Supports Upstash Redis REST or standard Redis ioredis)
REDIS_URL=redis://default:password@localhost:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Message Queue (LavinMQ / CloudAMQP / RabbitMQ)
LAVINMQ_URL=amqp://guest:guest@localhost:5672
AMQP_QUEUE_YAP_CREATED=yapr.yap.created
AMQP_QUEUE_NOTIFICATIONS=yapr.notifications
AMQP_QUEUE_EMAIL_OTP=yapr.email.otp
AMQP_QUEUE_AI_SUMMARY=yapr.ai.summary

# AI Providers (v3 Smart Features)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Custom SMTP Service (v2 OTP Service)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Yapr Team" <no-reply@yapr.app>

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
JWT_EXPIRES_IN=7d
